{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RDM",
  "version": "1.0.14",
  "identifier": "io.github.ruaavell.rdm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RDM - Rapid Download Manager",
        "width": 1120,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "shortDescription": "Linux-native download manager",
    "longDescription": "A Rust-powered native download manager for Linux.",
    "icon": [
      "icons/icon.png"
    ],
    "resources": [
      "../../../browser-extension.crx",
      "../../../browser-extension/native-host/rdm_native_host.py"
    ]
  }
}
